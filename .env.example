# Public values are compiled into the browser bundle.
NEXT_PUBLIC_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required while building the show snapshots, and as a Worker runtime secret.
MONGODB_URI=

# Worker runtime secrets for the existing Postgres database.
PG_DB_USER=
PG_DB_HOST=
PG_DB_NAME=
PG_DB_PASSWORD=
PG_DB_PORT=5432

# Worker runtime secrets for recommendations.
PINECONE_API_KEY=
PINECONE_DB_URL=
PINECONE_DB_TABLE=
